# API Server Configuration
# ========================

# HTTP Listen Address
API_LISTEN_ADDR=:3000

# API Endpoints
# =============
# POST   /asset                    - Create a new asset
# POST   /asset/transfer           - Transfer asset ownership
# GET    /asset/{assetId}          - Read asset details
# GET    /assets                   - List all assets
# GET    /assets/owner/{ownerId}   - Get assets by owner
# POST   /asset/{assetId}/verify   - Verify document hash

# Example API Test Commands
# ==========================
#
# Create Asset:
# curl -X POST http://localhost:3000/asset \
#   -H "Content-Type: application/json" \
#   -d '{"assetId":"asset-001","ownerId":"owner1","docHash":"hash123","metadata":"test"}'
#
# List Assets:
# curl -X GET http://localhost:3000/assets
#
# Read Asset:
# curl -X GET http://localhost:3000/asset/asset-001
